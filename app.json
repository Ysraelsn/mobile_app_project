{
  "expo": {
    "name": "BeeOnTime",
    "slug": "BeeOnTime",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#E3A542"
    },

    "scheme": "beeontime",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beeontime.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app necesita acceso a la cámara para escanear los códigos de barras de asistencia.",
        "NSMotionUsageDescription": "Permitir que esta app use el acelerómetro."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E3A542",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ysraelsn.BeeOnTime",
      "versionCode": 1,
      "permissions": [
        "android.permissions.camera",
        "android.permissions.notifications"
      ]
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "native",
          "backgroundColor": "#E3A542"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4a47752c-6093-4e3d-9255-3ad937630841"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4a47752c-6093-4e3d-9255-3ad937630841"
    }
  }
}
